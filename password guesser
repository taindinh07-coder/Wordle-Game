import random
from english_words import get_english_words_set


# Setup
web2_words = get_english_words_set(['web2'], lower=True)
word_list = [word for word in web2_words if len(word) == 5]
password = random.choice(word_list)

# Functions
def get_guess():
    while True:
        guess = input('Guess the word: ')
        if len(guess) == 5 and guess.isalpha(): #isalpha ensures it's only alphabetical letters
            return guess
        print('Guess must be a 5-letter word')


# Main Loop
for attempt in range(6):
    guess = get_guess()

    feedback = ''
    for i in range(5):
        if guess[i] == password[i]:
            feedback += '🟩'
        elif guess[i] in password:
            feedback += '🟨'
        else:
            feedback += '⬜'
    print(feedback)

    if guess == password: 
        print('You guessed the password!')
        break
else:
    print(f'Out of attempts! The password was {password}')
